# Postgres. Без него приложение работает на демо-наборе из lib/demo.ts:
# каталог, фильтры и документы отдаются из него, а формы не пишут в базу.
DATABASE_URL=postgresql://user:password@localhost:5432/hwangs

# Подпись сессии администратора (lib/admin.ts). Любая длинная случайная строка,
# например: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Без неё вход в админ недоступен — роут отвечает 500, а не выдаёт предсказуемую сессию.
ADMIN_SESSION_SECRET=

# Только для scripts/create-admin.mjs
ADMIN_USERNAME=
ADMIN_PASSWORD=
